{
    "name": "wsabol/huntrecipes",
    "type": "project",
    "description": "A Laravel-powered family recipe collection.",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "kreait/laravel-firebase": "^6.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10",
        "openai-php/client": "^0.10.3",
        "twig/twig": "^3.20"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "install:dev": [
            "@composer install --no-interaction --prefer-dist --optimize-autoloader"
        ],
        "install:prod": [
            "@composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader"
        ],
        "setup": [
            "@install:dev",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('storage/oauth-private.key') || passthru('php artisan passport:keys --no-interaction');\"",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve --port=8001\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,logs,assets"
        ],
        "db:migrate": [
            "@php artisan migrate --graceful --ansi"
        ],
        "db:dryrun": [
            "@php artisan migrate --pretend"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "npm ci",
            "npm run build",
            "@test"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:firebase-emulator": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "npx --yes firebase-tools@15.34.2 emulators:exec --only auth --project demo-huntrecipes \"php artisan test --group=firebase-emulator\""
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "pint": [
            "@php vendor/bin/pint --dirty"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
