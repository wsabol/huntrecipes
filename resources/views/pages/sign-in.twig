{% set show_footer = true %}
{% set hide_call_to_action = true %}
{% extends 'base.twig' %}

{% block page_title %}{% endblock %}

{% block main_content %}
<div class="row">
    <div class="col-lg-4 offset-lg-4">
        <div class="content sign-in-box" data-auth-screen data-return-url="{{ return_url }}">
            <div class="row mb-5"><div class="col-lg-8 offset-lg-2"><img class="w-100" src="/assets/images/ico/huntr_logo_transparent_scale.png" alt="HuntRecipes"></div></div>
            <h5 class="text-center mb-4">Sign in to HuntRecipes</h5>
            <div class="alert alert-danger" data-auth-error hidden></div>
            <div class="alert alert-success" data-auth-success hidden></div>
            <div class="alert alert-info text-center" data-auth-progress hidden>Signing you in...</div>

            <div data-auth-options>
            <button type="button" class="btn btn-outline-primary w-100 mb-4" data-google-sign-in>
                <i class="fa-brands fa-google me-2"></i> Continue with Google
            </button>

            <div class="text-center text-muted mb-4">or</div>
            <form data-email-link-form>
                {{ csrf_field() }}
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input required type="email" class="form-control" id="email" name="email" autocomplete="email" placeholder="you@example.com">
                </div>
                <div class="form-check mb-4">
                    <input class="form-check-input" type="checkbox" id="remember" name="remember">
                    <label class="form-check-label" for="remember">Remember me on this device</label>
                </div>
                <button type="submit" class="btn btn-primary w-100">Email me a sign-in link</button>
            </form>
            <p class="small text-muted mt-4 mb-0">No password is required. The email link verifies your address and signs you in.</p>
            <p class="mt-3"><a href="{{ route('home') }}">Browse without an account</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
